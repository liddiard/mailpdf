# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# The server loads `.env` automatically (via Node's --env-file-if-exists flag).
# Never commit your real `.env` file.

# ---------------------------------------------------------------------------
# Lob (https://dashboard.lob.com/settings/api-keys)
# Test keys are used when "demo" is in the URL; live keys are used otherwise.
# ---------------------------------------------------------------------------
LOB_API_KEY_TEST=
LOB_API_KEY=

# ---------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys)
# Test keys are used when "demo" is in the URL; live keys are used otherwise.
# ---------------------------------------------------------------------------
STRIPE_API_KEY_TEST=
STRIPE_API_KEY=

# ---------------------------------------------------------------------------
# Amazon SES (https://console.aws.amazon.com/ses/)
# The credentials need permission to send email (ses:SendEmail). The sender
# addresses (admin_alerts@ and order@mailpdf.online) must be verified in SES.
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email address that receives administrator error alerts.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Port the server listens on. Defaults to 3000.
# PORT=3000

# Set to "production" to enable rate limiting and hide error stack traces.
# NODE_ENV=development
