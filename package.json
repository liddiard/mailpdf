{
  "name": "mailpdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch bin/www.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env bin/www.js"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.5.1"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1129.0",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.16.0",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lob": "^8.1.1",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "mustache-express": "^1.3.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.1",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.2.2"
  }
}
